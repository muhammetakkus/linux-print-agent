{
  "Agent": {
    "StateDirectory": "/var/lib/nuxprint-agent",
    "CacheDirectory": "/var/cache/nuxprint-agent",
    "RuntimeDirectory": "/run/nuxprint-agent",
    "CupsServer": "http://localhost:631",
    "CupsSocketPath": "/run/cups/cups.sock",
    "MaxLocalClients": 16,
    "LocalRequestTimeoutSeconds": 90,
    "PrintSafety": {
      "MaxCopiesPerJob": 100,
      "MaxDocumentBytes": 20971520,
      "JobTimeoutSeconds": 60,
      "MaxCopiesPerMinute": 1000,
      "MaxJobsPerMinute": 60,
      "AllowRaw": true,
      "AllowedRawTypes": ["raw", "zpl", "escpos", "escp", "pcl", "postscript", "ps", "epl", "tspl", "cpcl", "text"]
    }
  }
}
