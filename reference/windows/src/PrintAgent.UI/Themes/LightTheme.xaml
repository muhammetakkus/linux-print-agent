<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary palette -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1AA3F0"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="SyncBrush" Color="#38BDF8"/>

    <!-- Surface -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#EAEEF2"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="White"/>
    <SolidColorBrush x:Key="TabBarBgBrush" Color="White"/>
    <SolidColorBrush x:Key="StatusBarBgBrush" Color="White"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#F1F5F9"/>

    <!-- Text -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8"/>

    <!-- Status badges -->
    <SolidColorBrush x:Key="StatusOnlineBgBrush" Color="#F0FDF4"/>
    <SolidColorBrush x:Key="StatusOfflineBgBrush" Color="#FEF2F2"/>

    <!-- Log terminal -->
    <SolidColorBrush x:Key="LogTerminalBgBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="LogTerminalBorderBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="LogTimeBrush" Color="#475569"/>
    <SolidColorBrush x:Key="LogMessageBrush" Color="#94A3B8"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBgBrush" Color="White"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#1AA3F0"/>
    <SolidColorBrush x:Key="InputFocusRingBrush" Color="#1AA3F033"/>

    <!-- Icons -->
    <SolidColorBrush x:Key="IconStrokeBrush" Color="#334155"/>
    <SolidColorBrush x:Key="CopyIconBrush" Color="#64748B"/>

    <!-- Tabs (underline style) -->
    <SolidColorBrush x:Key="TabTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TabActiveTextBrush" Color="#1AA3F0"/>
    <SolidColorBrush x:Key="TabIndicatorBrush" Color="#1AA3F0"/>
    <SolidColorBrush x:Key="TabHoverTextBrush" Color="#334155"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="TestButtonBgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ButtonDisabledBrush" Color="#9FD5F5"/>

    <!-- Login -->
    <SolidColorBrush x:Key="LabelBrush" Color="#475569"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="EyeIconBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="EyeHoverBgBrush" Color="#F1F5F9"/>

</ResourceDictionary>
