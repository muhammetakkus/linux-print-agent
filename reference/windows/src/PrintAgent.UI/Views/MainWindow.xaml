<Window x:Class="PrintAgent.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PrintAgent.UI.ViewModels"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="NuxPrint Agent" Width="600" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <!-- Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="NuxPrint Agent"
                        IconSource="/Resources/icon.ico"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="Show_Click"/>
                    <Separator/>
                    <MenuItem Header="Quit" Click="Quit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Login View -->
        <Grid x:Name="LoginPanel" Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibility}}" KeyDown="LoginForm_KeyDown">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                <Image Source="/Resources/icon.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="NuxPrint Agent" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource OnSurfaceBrush}"/>
                <TextBlock Text="Sign in to connect your printers" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,32"/>

                <!-- Sunucu aynı alanda e-posta veya kullanıcı adı kabul eder; istek gövdesi değişmedi. -->
                <TextBlock Text="Email or username" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7" Foreground="{DynamicResource LabelBrush}"/>
                <TextBox Style="{StaticResource InputBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

                <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7" Foreground="{DynamicResource LabelBrush}"/>
                <Grid Margin="0,0,0,18">
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBox}" PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBox x:Name="PasswordTextBox" Style="{StaticResource InputBox}" Visibility="Collapsed" TextChanged="PasswordTextBox_TextChanged"/>
                    <Button x:Name="TogglePasswordBtn" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" Click="TogglePassword_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="EyeBd" Background="Transparent" Padding="8" CornerRadius="6">
                                    <!-- Eye icon (visible state) -->
                                    <Canvas Width="18" Height="14">
                                        <Ellipse Canvas.Left="5.5" Canvas.Top="3.5" Width="7" Height="7" Stroke="{DynamicResource EyeIconBrush}" StrokeThickness="1.4" Fill="Transparent"/>
                                        <Path Stroke="{DynamicResource EyeIconBrush}" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 1 7 C 3 2 7 0 9 0 C 11 0 15 2 17 7 C 15 12 11 14 9 14 C 7 14 3 12 1 7"/>
                                    </Canvas>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="EyeBd" Property="Background" Value="{DynamicResource EyeHoverBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding LoginError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" Margin="0,0,0,10" Visibility="{Binding LoginError, Converter={StaticResource StringToVisibility}}"/>

                <Button x:Name="SignInButton" Height="48" FontSize="16" FontWeight="SemiBold" Foreground="White" Cursor="Hand" Click="Login_Click"
                        Content="{Binding IsLoggingIn, Converter={StaticResource LoginButtonText}}"
                        IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBool}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBd" Background="{DynamicResource ButtonDisabledBrush}" CornerRadius="11" Padding="20,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding LoginFormReady}" Value="True">
                                    <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="BtnBd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#1AA3F0" BlurRadius="20" ShadowDepth="8" Direction="270" Opacity="0.55"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource ButtonDisabledBrush}"/>
                                    <Setter TargetName="BtnBd" Property="Effect" Value="{x:Null}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Dashboard View -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logout Spinner Overlay -->
            <Grid Grid.RowSpan="2" Panel.ZIndex="100" Visibility="{Binding IsLoggingOut, Converter={StaticResource BoolToVisibility}}">
                <Border Background="#80FFFFFF"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="16" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                    <TextBlock Text="Logging out..." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>

            <!-- TabControl -->
            <TabControl Grid.Row="0" BorderThickness="0" Background="Transparent" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="18,15" Cursor="Hand" BorderThickness="0,0,0,2.5" BorderBrush="Transparent">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabIndicatorBrush}"/>
                                            <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource TabActiveTextBrush}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource TabHoverTextBrush}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="{DynamicResource TabTextBrush}"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </TabControl.Resources>

                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource TabBarBgBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1" Padding="16,0,16,0">
                                <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Account Tab -->
                <TabItem Header="Account">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Account Info" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,20"/>

                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Email" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Customer.Email}" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Name" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Customer.Name}" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Device ID" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DeviceId}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Version" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center">
                                                <Run Text="v"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
                                            </TextBlock>
                                            <!-- API'den gelen yayındaki sürüm; okunamadıysa hiç görünmez. -->
                                            <TextBlock Text="{Binding LatestVersionLabel}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding LatestVersionLabel, Converter={StaticResource StringToVisibility}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="API Key" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Customer.ApiKey}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                        <Button Grid.Column="2" Cursor="Hand" ToolTip="Copy API Key" Click="CopyApiKey_Click" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CpBd" Background="Transparent" Padding="6,4" CornerRadius="4">
                                                        <Canvas Width="12" Height="12" Opacity="0.5">
                                                            <Rectangle Canvas.Left="3" Canvas.Top="0" Width="9" Height="9" Stroke="{DynamicResource CopyIconBrush}" StrokeThickness="1.2" RadiusX="1.5" RadiusY="1.5"/>
                                                            <Rectangle Canvas.Left="0" Canvas.Top="3" Width="9" Height="9" Stroke="{DynamicResource CopyIconBrush}" StrokeThickness="1.2" Fill="{DynamicResource CardBgBrush}" RadiusX="1.5" RadiusY="1.5"/>
                                                        </Canvas>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CpBd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Printers Tab -->
                <TabItem Header="Printers">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Printers" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" ToolTip="Refresh" Command="{Binding RefreshCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RfBd" Background="Transparent" Padding="6" CornerRadius="6">
                                                    <Canvas Width="16" Height="16" Opacity="0.5">
                                                        <Path Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="1.6" Fill="Transparent"
                                                              Data="M 13 8 A 5 5 0 1 1 8 3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <Path Fill="{DynamicResource IconStrokeBrush}" Data="M 7 0.5 L 9.5 3 L 7 5.5 Z"/>
                                                    </Canvas>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RfBd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <ListBox ItemsSource="{Binding Printers}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,6" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                                                            <Run Text="{Binding DriverName, Mode=OneWay}"/> · <Run Text="{Binding ConnectionType, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                                   Visibility="{Binding ExternalId, Converter={StaticResource StringToVisibility}}">
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                                                                <Run Text="ID:"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding ExternalId, Mode=OneWay}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            <Button Padding="4,2" Margin="6,0,0,0" Cursor="Hand" ToolTip="Copy Printer ID" Click="CopyPrinterId_Click" Tag="{Binding ExternalId}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="CpPBd" Background="Transparent" Padding="6,4" CornerRadius="4">
                                                                            <Canvas Width="12" Height="12" Opacity="0.5">
                                                                                <Rectangle Canvas.Left="3" Canvas.Top="0" Width="9" Height="9" Stroke="{DynamicResource CopyIconBrush}" StrokeThickness="1.2" RadiusX="1.5" RadiusY="1.5"/>
                                                                                <Rectangle Canvas.Left="0" Canvas.Top="3" Width="9" Height="9" Stroke="{DynamicResource CopyIconBrush}" StrokeThickness="1.2" Fill="{DynamicResource CardBgBrush}" RadiusX="1.5" RadiusY="1.5"/>
                                                                            </Canvas>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="CpPBd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource StatusOfflineBgBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="online">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusOnlineBgBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="unknown">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="OFFLINE"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="online">
                                                                            <Setter Property="Text" Value="ONLINE"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="unknown">
                                                                            <Setter Property="Text" Value="KONTROL"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <Button Grid.Column="2" Content="Test" FontSize="11" Padding="14,6" Cursor="Hand" VerticalAlignment="Center" Command="{Binding DataContext.TestPrintCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{DynamicResource TestButtonBgBrush}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No printers found" Visibility="{Binding Printers.Count, Converter={StaticResource ZeroToVisibility}}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,20"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- Jobs Tab -->
                <TabItem Header="Jobs">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Print Jobs" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Content="Clear" FontSize="11" Padding="14,6" Command="{Binding ClearJobsCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{DynamicResource TestButtonBgBrush}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <ListBox ItemsSource="{Binding Jobs}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,6" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DocumentName}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                                                            <Run Text="{Binding PrinterName, Mode=OneWay}"/> · <Run Text="{Binding ReceivedAt, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource StatusOfflineBgBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="done">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusOnlineBgBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="printing">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="FAILED"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="done">
                                                                            <Setter Property="Text" Value="DONE"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="printing">
                                                                            <Setter Property="Text" Value="PRINTING"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No print jobs yet" Visibility="{Binding Jobs.Count, Converter={StaticResource ZeroToVisibility}}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,20"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- Log Tab -->
                <TabItem Header="Log">
                    <Border Margin="20" Background="{DynamicResource LogTerminalBgBrush}" BorderBrush="{DynamicResource LogTerminalBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,22">
                        <ListBox ItemsSource="{Binding Logs}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="13" FontFamily="Consolas, 'SF Mono', Menlo, ui-monospace" Margin="0,0,0,4" TextWrapping="Wrap">
                                        <TextBlock.LineHeight>24.7</TextBlock.LineHeight>
                                        <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}" Foreground="{DynamicResource LogTimeBrush}"/>
                                        <Run Text=" "/>
                                        <Run FontWeight="Bold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Text" Value="{Binding Level, Mode=OneWay}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Message, Mode=OneWay}" Foreground="{DynamicResource LogMessageBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- Status Bar -->
            <Border Grid.Row="1" Background="{DynamicResource StatusBarBgBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnectedToApi}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionState}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" · " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding Printers.Count, Mode=OneWay}"/>
                            <Run Text=" printer(s)"/>
                        </TextBlock>
                        <TextBlock Text=" · " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                        <!-- Kurulu sürüm; API yeni bir sürüm bildirdiğinde "v1.9.4 (v1.9.5)" olur. -->
                        <TextBlock Text="{Binding VersionLabel}" FontSize="11" VerticalAlignment="Center"
                                   ToolTip="{Binding LatestVersionLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Yeni sürüm varsa (zorunlu olsun olmasın) Logout ile aynı minimal metin düğmesi. -->
                        <Button Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" Command="{Binding UpdateCommand}"
                                ToolTip="{Binding LatestVersionLabel}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="{Binding UpdateButtonLabel}" FontSize="11" FontWeight="SemiBold" TextDecorations="Underline">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Command="{Binding LogoutCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="Logout" FontSize="11" Foreground="{DynamicResource ErrorBrush}"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
